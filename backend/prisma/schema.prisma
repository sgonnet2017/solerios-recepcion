generator client {
  provider = "prisma-client-js"
}

// En qué schema (compartimento de la base) viven las tablas no se escribe acá:
// lo dice la variable DB_SCHEMA ("recepcion" si no está, que es la base real;
// "solerios-testing" en la compu para probar). Ver prisma.config.ts y
// src/services/prisma.service.js.
datasource db {
  provider = "postgresql"
}

// Cochera del edificio. El estado (Libre / Ocupada / Venció) no se guarda: se
// calcula con sus asignaciones y la fecha de hoy.
model Cochera {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo       String       @unique
  asignaciones Asignacion[]
  // Se suma 1 cada vez que se asigna, reserva o extiende esta cochera. No
  // importa el número: actualizar la fila la "traba" hasta que termina la
  // operación, así dos recepcionistas no pueden cargar fechas que se pisen
  // al mismo tiempo (la segunda espera y después ve lo que guardó la primera).
  version      Int          @default(0)
  createdAt    DateTime     @default(now())

  @@map("cocheras")
}

// Una cochera usada (o reservada a futuro) por un apartamento durante un
// período. Nunca se borra: al liberarla o cancelarla se completa liberadaEn, y
// así queda el historial. Dos asignaciones activas de la misma cochera no
// pueden pisarse en fechas (lo controla cocheras.routes.js, trabando la cochera).
model Asignacion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cocheraId   String    @db.Uuid
  cochera     Cochera   @relation(fields: [cocheraId], references: [id])
  // texto libre que escribe recepción, ej. "201" o "Jorge Perez 201"
  apartamento String
  desde       DateTime  @db.Date
  // vacío = sin fecha de fin
  hasta       DateTime? @db.Date
  // vacío mientras está activa (en uso o reservada); con fecha = liberada o cancelada
  liberadaEn  DateTime?
  // YA NO SE USA (era la regla anti-choque cuando no había reservas a
  // futuro). Queda vacío; se puede borrar más adelante, cuando la versión
  // vieja de la app ya no esté publicada.
  enUsoCocheraId String?  @unique @db.Uuid
  creadoPor   String?
  createdAt   DateTime  @default(now())

  @@index([cocheraId])
  @@map("asignaciones")
}

// Reserva del hidromasaje (inicio → fin, con la limpieza incluida). Lo que
// impide que dos reservas se pisen son sus bloques (ver ReservaBloque).
model Reserva {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // en cuál de los hidromasajes (ver HIDROMASAJES en src/constants.js)
  hidromasaje Int             @default(1)
  apartamento String
  // opcional, lo escribe recepción al reservar (ej. "trae toallas propias")
  comentario  String?
  inicio      DateTime
  fin         DateTime
  // cancelar no borra: completa canceladaEn y borra sus bloques
  canceladaEn DateTime?
  bloques     ReservaBloque[]
  creadoPor   String?
  createdAt   DateTime        @default(now())

  @@index([inicio])
  @@map("reservas")
}

// Un pedazo de 15 minutos (BLOQUE_MIN en reservas.routes.js) que ocupa una
// reserva activa. Una reserva a las 15:00 (hasta las 16:00) tiene cuatro:
// 15:00, 15:15, 15:30 y 15:45. La clave es hidromasaje + inicio (@@id, no
// se puede repetir): la base rechaza que dos reservas ocupen el mismo pedazo
// del MISMO hidromasaje, aunque empiecen a horas distintas y se guarden en el
// mismo instante. El 1 y el 2 pueden estar ocupados a la misma hora.
model ReservaBloque {
  hidromasaje Int      @default(1)
  inicio      DateTime
  reservaId   String   @db.Uuid
  reserva     Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@id([hidromasaje, inicio])
  @@index([reservaId])
  @@map("reserva_bloques")
}
