DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
# Tiene que ser EL MISMO secreto que usa el Portal: así esta app acepta los
# tokens con los que el Portal manda a los usuarios (?token=...)
JWT_SECRET="your-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
PORTAL_API_URL="https://..."
# Schema de la base. En la compu: "solerios-testing" (para probar sin tocar
# datos reales). En Vercel (producción) no se carga: usa "recepcion", la real.
DB_SCHEMA="solerios-testing"
NODE_ENV=development
PORT=3010
CORS_ORIGINS="http://localhost:5180"
